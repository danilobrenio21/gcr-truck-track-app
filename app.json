{
  "expo": {
    "name": "GCR TruckTrack",
    "slug": "gcr-truck-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F8FA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Track GCR food product delivery trucks in real-time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#38B6FF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    }
  }
}
